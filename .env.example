# 이 파일을 .env 로 복사해서 쓰세요.  cp .env.example .env
#
#   .env 는 .gitignore 에 들어 있어 **커밋되지 않습니다.**
#   ./run.sh 가 뜰 때 자동으로 읽습니다(창을 닫아도 다음에 또 읽습니다).
#   값에 따옴표는 안 붙여도 됩니다. 붙여도 떼어 냅니다.

# 국장(🇰🇷 한국) 분기 실적·forward PER 에 필요합니다. 미장은 필요 없습니다.
#   받는 곳: https://opendart.fss.or.kr  →  인증키 신청 (무료, 1분)
#   메일로 40자리 키가 옵니다.
DART_API_KEY=

# 아래는 없어도 됩니다 — 있으면 실적 컨콜(Earnings-AI) 쪽에서 씁니다.
# EAI_TRANSCRIPT_API_KEY=
# EAI_ALPHAVANTAGE_API_KEY=

# 포트를 바꾸고 싶을 때(이미 8000 을 쓰는 서버가 있을 때).
# SUH_DH_PORT=8001
