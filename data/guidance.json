{
  "_schema": {
    "description": "Curated next-quarter guidance vs point-in-time consensus, keyed by ticker. The free Yahoo API does not carry these two numbers, so they are filled by hand (method B: read from the earnings-day press release / news) with source links. app/earnings.py reads this file, grades each entry (대폭상회/상회/소폭상회/부합/소폭하회/하회/대폭하회), and attaches it to the matching report-date row of /api/earnings/{ticker} and /api/drift/{ticker}.",
    "entry_fields": {
      "report_date": "YYYY-MM-DD — the earnings date at which the guidance was given (must equal the quarter's date in the drift table so it merges).",
      "guided_period": "Human label for the quarter being guided, e.g. 'FY26 Q3'.",
      "metric": "revenue | eps | gross_margin — which figure this entry compares.",
      "unit": "Display unit, e.g. 'B_USD' (billions), 'USD' (per-share EPS), 'pct'.",
      "guidance_mid": "Company guidance midpoint (number). Required for grading.",
      "guidance_low": "Optional low end of the guided range.",
      "guidance_high": "Optional high end of the guided range.",
      "consensus": "Analyst consensus for the same metric/quarter AS OF the report date. Required for grading.",
      "note": "Optional free-text context (Korean ok).",
      "sources": "List of source URLs the numbers came from."
    }
  },
